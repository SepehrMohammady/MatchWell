# MatchWell Multiplayer API - Apache Configuration
# The app calls the .php files directly, so no rewrites are needed here.
#
# This folder previously had no .htaccess at all, which left schema.sql readable
# over HTTP (structure only, no data) and the directory listable.

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
</IfModule>

# Prevent directory listing
Options -Indexes

# Block access to config and schema
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

<Files "schema.sql">
    Order Allow,Deny
    Deny from all
</Files>
